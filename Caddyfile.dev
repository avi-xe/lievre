:80 {
    # Proxy known backend routes
    handle /api/* {
        reverse_proxy app:3000
    }
    handle /health {
        reverse_proxy app:3000
    }

    # Federation routes (ActivityPub)
    handle /.well-known/* {
        reverse_proxy app:3000
    }
    handle /users/* {
        reverse_proxy app:3000
    }

    # Proxy frontend to Vite dev server
    handle {
        reverse_proxy frontend:5173
    }
}
