# E2E Dockerfile — fast debug builds for local development
FROM rust:latest

RUN apt-get update && apt-get install -y \
    ca-certificates \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy everything — Docker layer cache handles the rest
COPY . .

# Build in debug mode (fast incremental builds)
RUN cargo build -p lievre-api

RUN mkdir -p /app/data

EXPOSE 3000

CMD ["lievre"]
